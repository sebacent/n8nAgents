# ============================================================
# WHATSAPP AGENT - VARIABLES DE ENTORNO
# Copiar este archivo a .env y completar los valores
# ============================================================

# ------------------------------------------------------------
# OPENAI
# ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# SUPABASE
# Obtener en: https://supabase.com → Settings → API
# ------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# IMPORTANTE: Usar la SERVICE ROLE KEY (no la anon key)
# La service role key bypasea el RLS y permite insertar datos desde n8n.

# ------------------------------------------------------------
# EVOLUTION API
# ------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-this-api-key-min-20-chars
EVOLUTION_INSTANCE=personal

# ------------------------------------------------------------
# n8n
# ------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678

# Para producción con dominio:
# N8N_HOST=tudominio.com
# N8N_PROTOCOL=https
# N8N_WEBHOOK_URL=https://tudominio.com

# Autenticación de la UI de n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=password-seguro-aqui

# Clave de encriptación de n8n (mínimo 32 caracteres, generar aleatoriamente)
N8N_ENCRYPTION_KEY=genera-32-chars-aleatorios-aqui!!
